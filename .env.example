# WellPulse environment template (copy to backend/.env; .env is git-ignored). No API keys: Vertex AI via ADC.
GOOGLE_CLOUD_PROJECT=workover-operations-agentic-ai
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# --- Gemini Live (Stage U, SDD §11.7) ---------------------------------------------------------
# Verified 2026-10-07 with `cd backend && uv run python -m app.live.verify_model`:
#   models.list(us-central1) LIVE: gemini-live-2.5-flash-native-audio, gemini-3.5-transcribe-live-preview,
#                                  gemini-3.5-live-translate-preview, gemini-3.8-live
#   live.connect gemini-3.8-live@us-central1 -> OK (audio + turn_complete); @global -> 1008 not found.
WELLPULSE_LIVE_MODEL=gemini-3.8-live
WELLPULSE_LIVE_LOCATION=us-central1
# Explicit: wins over a shell-level GOOGLE_CLOUD_PROJECT (python-dotenv never overrides existing env vars).
WELLPULSE_LIVE_PROJECT=workover-operations-agentic-ai
# Aliases read by the same code (ADK-repo naming); WELLPULSE_* wins if both are set.
WORKOVER_LIVE_MODEL=gemini-3.8-live
WORKOVER_LIVE_LOCATION=us-central1
WELLPULSE_LIVE_VOICE=Aoede
# WELLPULSE_LIVE_OFFLINE=1          # skip Gemini Live, text fallback only
# WELLPULSE_DEBUG_RECONNECT=1       # allow {"type":"debug_reconnect"} to force a resume (tests/demo)
# WELLPULSE_LIVE_TOOL_TIMEOUT_S=10

# --- Text model (D-13) ------------------------------------------------------------------------
# gemini-3.8-flash: listed in us-central1 but generate_content -> 404 there; works in `global`.
WELLPULSE_TEXT_MODEL=gemini-3.8-flash
WELLPULSE_TEXT_LOCATION=global

BACKEND_PORT=8002
